{
   "network":
   {
      "inputLayer": 2,
      "hiddenLayer": 5,
      "outputLayer": 3
   },

   "data":
   {
      "numCases": 4,
      "inputFile": "data/inputs/inputs_2in_4case.bin",
      "truthTableFile": "data/truth/truth_andorxor_4case_3out.txt"
   },

   "training":
   {
      "isTraining": true,
      "useRandomWeights": true,
      "_weightRange": "random init draws from [low, high]; ignored if useRandomWeights is false",
      "low": 0.1,
      "high": 1.5,
      "lambda": 0.3,
      "maxIterations": 40000,
      "errorThreshold": 2e-4
   },

   "execution":
   {
      "shouldRun": true,
      "activationFunction": "sigmoid",
      "_activationOptions": "sigmoid | tanh | linear"
   },

   "display":
   {
      "showInputTable": true,
      "showTruthTable": true
   },

   "files":
   {
      "_loadNote": "set loadFile to non-empty and useRandomWeights to false to run from saved weights",
      "loadFile":  "",
      "saveFile":  "data/weights/save.bin"
   }
}
